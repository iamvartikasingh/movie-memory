# Copy to .env and fill in. Never commit .env.

# Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/movie_memory"

# Auth.js: generate with `openssl rand -base64 32`
AUTH_SECRET=""

# Google OAuth client (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# OpenAI
OPENAI_API_KEY=""
# Optional, defaults to gpt-4o-mini
# OPENAI_MODEL="gpt-4o-mini"

# Optional: TMDB "API Read Access Token" for the dashboard backdrop
# (https://www.themoviedb.org/settings/api)
TMDB_READ_ACCESS_TOKEN=""

# Only needed for `npm run build && npm start` (production mode on localhost)
# AUTH_TRUST_HOST=true
